# key clients must send as "Authorization: Bearer <key>"
AGENT_API_KEY=change-me
# free key from https://aistudio.google.com
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# deploy (python deploy.py). write token from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SPACE=your-user/cv-agent
